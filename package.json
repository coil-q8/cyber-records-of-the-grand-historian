{
  "name": "cyber-records-of-the-grand-historian",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run research:progress",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "preview": "vite preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "check": "tsc -b && tsc -p tsconfig.worker.json",
    "dev:api": "wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "admin:setup": "node scripts/prepare-admin-setup.mjs",
    "test:community": "node scripts/community-smoke.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "research:progress": "node scripts/generate-research-progress.mjs",
    "research:batch02": "node scripts/generate-phase2-batch-02.mjs && node scripts/generate-research-progress.mjs",
    "research:batch03": "node scripts/generate-phase2-batch-03.mjs && node scripts/generate-research-progress.mjs",
    "research:batch04": "node scripts/generate-phase2-batch-04.mjs && node scripts/generate-research-progress.mjs",
    "research:batch05": "node scripts/generate-phase2-batch-05.mjs && node scripts/generate-research-progress.mjs",
    "research:batch06": "node scripts/generate-phase2-batch-06.mjs && node scripts/generate-research-progress.mjs",
    "research:batch07": "node scripts/generate-phase2-batch-07.mjs && node scripts/generate-research-progress.mjs",
    "research:batch08": "node scripts/generate-phase2-batch-08.mjs && node scripts/generate-research-progress.mjs",
    "research:batch09": "node scripts/generate-phase2-batch-09.mjs && node scripts/generate-research-progress.mjs",
    "research:batch10": "node scripts/generate-phase2-batch-10.mjs && node scripts/generate-research-progress.mjs",
    "research:batch11": "node scripts/generate-phase2-batch-11.mjs && node scripts/generate-research-progress.mjs",
    "research:expand-batch": "node scripts/expand-phase2-batch.mjs",
    "preaudit": "npm run research:progress",
    "audit": "node scripts/audit-events.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "framer-motion": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^26.6.5",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "playwright-core": "^1.62.1",
    "typescript": "latest",
    "vite": "6.4.5",
    "wrangler": "4.154.0"
  }
}
